APP_ENV=local
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/tarororo
AUTH_MODE=mock
AUTH_SUBJECT_SECRET=REPLACE_WITH_A_SECRET_OF_AT_LEAST_32_CHARACTERS
AUTH_SUBJECT_SECRET_VERSION=v1
# During rotation, map retained older versions to their secrets as JSON:
# AUTH_SUBJECT_PREVIOUS_SECRETS='{"v0":"REPLACE_WITH_THE_PREVIOUS_SECRET_OF_AT_LEAST_32_CHARACTERS"}'
ALLOWED_ORIGINS=http://localhost:5173
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=REPLACE_WITH_A_SERVER_SIDE_KEY
# Required only when AUTH_MODE=toss:
# TOSS_MTLS_CERT_PATH=/absolute/path/to/client-cert.pem
# TOSS_MTLS_KEY_PATH=/absolute/path/to/client-key.pem
