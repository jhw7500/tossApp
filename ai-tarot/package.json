{
  "name": "ai-tarot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build && ait build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --experimental-strip-types --test src/api/client.test.ts src/features/native-back.test.ts src/features/pagination.test.ts src/features/person-conflict.test.ts dev/lan-crypto.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "deploy": "ait deploy"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.2.0",
    "@emotion/react": "^11.0.0",
    "@toss/tds-colors": "latest",
    "@toss/tds-mobile": "latest",
    "@toss/tds-mobile-ait": "latest",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "^3.2.0",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "1.58.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "json-schema-to-ts": "^3.1.1",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
